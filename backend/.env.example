# Copy to backend/.env and adjust paths.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage (relative to backend/ or absolute) ---
STORAGE_DIR=storage
MAX_UPLOAD_MB=100

# Built web UI dir. When it exists, the API serves it at "/" (one process /
# one port). `./run start` and the Docker image populate it; `./run dev` doesn't.
STATIC_DIR=static

# --- Stemdeck (https://github.com/stemdeckapp/stemdeck) ---
# Path to the stemdeck CLI executable, or "stemdeck" if on PATH.
STEMDECK_BIN=stemdeck
# Optional extra CLI args, space separated.
STEMDECK_ARGS=
# Fallback separator when stemdeck is unavailable: "none" or "demucs".
STEM_FALLBACK=none

# --- Audiveris OMR (Java CLI) ---
# Path to the Audiveris launcher script or bin, or "audiveris" if on PATH.
AUDIVERIS_BIN=audiveris
# Java executable (Audiveris 5.x requires Java 17+).
JAVA_BIN=java
# Timeout for a single OMR subprocess run (seconds).
OMR_TIMEOUT=600

# --- URL / YouTube audio ingestion (yt-dlp + ffmpeg) ---
YOUTUBE_ENABLED=true
FFMPEG_BIN=ffmpeg
# Reject videos longer than this (protects against huge downloads).
YOUTUBE_MAX_DURATION_SEC=900
# Comma-separated host allowlist for the /api/upload-url endpoint.
YOUTUBE_ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be

# --- Device ---
TORCH_DEVICE=mps
